# Copy variable names into your local PowerShell session. Never commit a real key.
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_MODEL=auto
FREELLMAPI_API_KEY=

# Optional comma-separated browser origins for a separately hosted frontend.
# The recommended same-origin /website route does not need CORS.
ECHO_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Enable only for an approved public demo behind an HTTPS tunnel. This hides
# private/admin APIs and applies stricter Echo rate limits. Default is off.
ECHO_PUBLIC_DEMO_MODE=0

# Optional database override for local test/dev data.
# DATABASE_URL=sqlite:///./campus.db
